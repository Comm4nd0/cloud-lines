# Cloud-Lines Deployment Configuration
# =====================================
#
# Infrastructure (one-time):
#   aws cloudformation deploy \
#     --template-file cloudformation.yml \
#     --stack-name cloudlines \
#     --parameter-overrides KeyPairName=your-key
#
# Then:
#   1. Copy this file:    cp deploy.conf.example deploy.conf
#   2. Fill in ALL values below
#   3. Deploy the app:    ./deploy.sh --config deploy.conf --stack cloudlines
#
# Subsequent updates:
#   ./deploy.sh --config deploy.conf
#
# Force a clean Docker rebuild:
#   ./deploy.sh --config deploy.conf --no-cache
#
# No prompts will appear if every value is filled in.
# This file is git-ignored — your secrets stay local.

# ── Server Connection ────────────────────────────────────────────────────────
AWS_REGION="eu-west-2"
SSH_KEY_PATH="$HOME/.ssh/cloudlines-key.pem"

# Server IP — set manually or use --stack to resolve from CloudFormation
SERVER_IP=""

# ── Domain & SSL ─────────────────────────────────────────────────────────────
# Leave DOMAIN blank to access the site via the server IP only
DOMAIN=""
# Set to "yes" to enable Let's Encrypt (requires a valid DOMAIN above)
SETUP_SSL="no"
SSL_EMAIL=""

# ── Application ──────────────────────────────────────────────────────────────
SITE_NAME="app"
DB_NAME="cloudlines"
DB_USER="cloudlines"

# ── Secrets (fill these in) ──────────────────────────────────────────────────
SECRET_KEY=""
DB_PASSWORD=""

# AWS keys used for S3 media storage and SES email
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="media.cloud-lines.com"

# Stripe payment keys
STRIPE_SECRET_KEY=""
STRIPE_PUBLIC_KEY=""
STRIPE_TEST_SECRET_KEY=""
STRIPE_TEST_PUBLIC_KEY=""
