# Django
DJANGO_SETTINGS_MODULE=cloudlines.settings
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=False
ALLOWED_HOSTS=*.cloud-lines.com,cloud-lines.com

# Database
DB_NAME=cloudlines
DB_USER=cloudlines
DB_PASSWORD=changeme
DB_HOST=db
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=media.cloud-lines.com
AWS_S3_REGION_NAME=eu-west-2

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PUBLIC_KEY=

# Email (SES)
EMAIL_BACKEND=django_ses.SESBackend
AWS_SES_REGION_NAME=eu-west-2
AWS_SES_REGION_ENDPOINT=email.eu-west-2.amazonaws.com
DEFAULT_FROM_EMAIL=contact@masys.co.uk

# External services (keep until fully migrated to Celery tasks)
ORCH_URL=
ORCH_USER=
ORCH_PASS=
METRICS_URL=

# Protocol
HTTP_PROTOCOL=https
